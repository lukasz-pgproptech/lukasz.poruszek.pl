# Klucze API pobierzesz z Panelu Sprzedawcy Paynow:
# Ustawienia -> Sklepy i punkty płatności -> [Twój sklep] -> Dane uwierzytelniające
# Dokumentacja API Paynow: https://github.com/pay-now
# ==============================================================================

# Klucz dostępu do API Paynow (Api-Key)
PAYNOW_API_KEY=

# Klucz do obliczania sygnatury HMAC SHA-256 (Signature Key)
PAYNOW_SIGNATURE_KEY=

# Środowisko bramki: 'sandbox' (testowe) lub 'production' (produkcyjne)
PAYNOW_ENV=sandbox

# Klucz API Cal.com
CAL_API_KEY=cal_live_c60e9d492b4c6ca4e69f6901d24b94b5
