---
import Base from '../layouts/Base.astro';
---

<Base title="404: Nie znaleziono strony">
  <section class="min-h-[80vh] flex items-center justify-center py-20">
    <div class="max-w-xl mx-auto px-5 text-center space-y-6">
      <div class="font-mono text-xs text-blue-400 uppercase tracking-widest">
        // BŁĄD 404 • SYSTEM STATUS: NOT FOUND
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-bold text-white tracking-tight">
        Adres nie istnieje
      </h1>
      <p class="text-sm sm:text-base text-[#7e8594] font-body leading-relaxed">
        Podany zasób został przeniesiony lub usunięty. Wróć na stronę główną, aby zapoznać się z programem warsztatów i mentoringu.
      </p>
      <div class="pt-4">
        <a 
          href="/" 
          class="inline-flex items-center justify-center gap-2 px-6 py-4 bg-white text-[#090a0c] font-mono text-xs uppercase font-bold tracking-wider hover:bg-neutral-200 hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 min-h-[48px]"
          data-cursor="Główna"
        >
          <span class="text-[#090a0c]">← Powrót na stronę główną</span>
        </a>
      </div>
    </div>
  </section>
</Base>
