---
import { site } from '../data/site';
---

<div id="loader" role="status" aria-label="Ładowanie strony">
  <div class="loader__inner max-w-7xl mx-auto w-full">
    <div class="space-y-2">
      <div data-loader-out class="text-xs font-mono uppercase tracking-widest text-[#8b94a5]">
        [SYSTEM: INIT // {site.name.toUpperCase()}]
      </div>
      <div data-loader-out class="text-sm font-mono text-[#f3f4f6]">
        Inżynieria systemów agentowych & transfer wiedzy
      </div>
    </div>
    <div data-loader-out data-loader-count class="loader__count">
      000%
    </div>
  </div>
  <div data-loader-bar class="loader__bar"></div>
</div>

