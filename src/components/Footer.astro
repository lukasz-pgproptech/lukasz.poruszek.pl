---
import { site } from '../data/site';
---

<footer class="py-16 border-t border-white/[0.08] bg-[#060709] relative">
  <div class="max-w-[1360px] mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/[0.06]">
      <!-- Brand & Mission (5 cols) -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-2.5 h-2.5 bg-blue-500 rounded-xs"></div>
          <span class="font-display font-bold text-lg text-white">
            {site.name}
          </span>
        </div>
        <p class="text-xs sm:text-sm text-[#9ca3af] font-body leading-relaxed max-w-sm">
          Praktyczny transfer wiedzy inżynierskiej, architektura systemów agentowych i dekonstrukcja barier biznesowych.
        </p>
        <div class="font-mono text-xs text-neutral-400">
          © {new Date().getFullYear()} {site.company}. Wszelkie prawa zastrzeżone.
        </div>
      </div>

      <!-- Legal Data (4 cols) -->
      <div class="md:col-span-4 space-y-2 font-mono text-xs text-[#9ca3af]">
        <div class="text-white font-semibold uppercase tracking-wider mb-2">
          // DANE REJESTROWE SPÓŁKI
        </div>
        <div>{site.company}</div>
        <div>NIP: <span class="text-white">{site.nip}</span></div>
        <div>REGON: <span class="text-white">{site.regon}</span></div>
        <div>KRS: <span class="text-white">{site.krs}</span></div>
        <div class="pt-2 text-neutral-400">
          Sąd Rejonowy dla m.st. Warszawy w Warszawie
        </div>
      </div>

      <!-- Links & Contact (3 cols) -->
      <div class="md:col-span-3 space-y-3 font-mono text-xs">
        <div class="text-white font-semibold uppercase tracking-wider mb-2">
          // KONTAKT I PROFILE
        </div>
        <div>
          <a href={`mailto:${site.email}`} class="text-blue-400 hover:text-blue-300 transition-colors py-2 inline-block min-h-[44px] flex items-center">
            {site.email}
          </a>
        </div>
        <div class="flex flex-col gap-2 pt-1 text-[#9ca3af]">
          {site.socials.map((s) => (
            <a 
              href={s.href} 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-white transition-colors flex items-center gap-2 py-2 min-h-[44px]"
            >
              <span>↗</span>
              <span>{s.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Colophon Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-[#9ca3af]">
      <div>
        Architektura: Astro 5 • Tailwind v4 • Lenis • GSAP • Zero AI Slop.
      </div>
      <div>
        <a href="#hero" class="hover:text-white transition-colors flex items-center gap-1.5 py-2 min-h-[44px]">
          <span>↑ Powrót na górę</span>
        </a>
      </div>
    </div>
  </div>
</footer>
