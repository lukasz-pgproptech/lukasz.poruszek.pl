---
import { site } from '../data/site';
---

<div 
  id="checkout-modal" 
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div 
    class="bg-[#12151b] border border-white/[0.15] w-full max-w-lg p-6 sm:p-8 relative shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto"
  >
    <!-- Modal Close Button -->
    <button 
      type="button" 
      id="close-modal-btn"
      class="absolute top-5 right-5 text-[#8b94a5] hover:text-white p-2 font-mono text-sm"
      aria-label="Zamknij okno"
    >
      ✕
    </button>

    <!-- Header -->
    <div class="space-y-1 pr-8">
      <div class="font-mono text-[11px] text-blue-400 uppercase tracking-widest">
        // POTWIERDZENIE ZGŁOSZENIA
      </div>
      <h3 id="modal-title" class="font-display text-xl sm:text-2xl font-bold text-white">
        Finalizacja zapisu
      </h3>
    </div>

    <!-- Product Summary Card -->
    <div class="p-4 bg-[#090a0c] border border-white/[0.08] space-y-2">
      <div class="flex justify-between items-start gap-4">
        <div>
          <div id="modal-product-name" class="font-display font-semibold text-sm sm:text-base text-white">
            Warsztaty Orkiestracji AI (Kohorta #01)
          </div>
          <div class="font-mono text-xs text-[#8b94a5] mt-0.5">
            Realizacja: {site.company}
          </div>
        </div>
        <div class="text-right shrink-0">
          <div id="modal-product-price" class="font-display text-xl font-bold text-white">
            1200 zł
          </div>
          <div class="font-mono text-[10px] text-[#8b94a5]">
            brutto (VAT 23%)
          </div>
        </div>
      </div>
    </div>

    <!-- Form -->
    <form id="order-form" class="space-y-4">
      <div>
        <label for="buyer-name" class="block font-mono text-xs text-[#8b94a5] uppercase mb-1">
          Imię i nazwisko *
        </label>
        <input 
          type="text" 
          id="buyer-name" 
          required 
          placeholder="Jan Kowalski"
          class="w-full bg-[#090a0c] border border-white/[0.12] px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-neutral-600 focus:outline-none focus:border-blue-500 transition-colors"
        />
      </div>

      <div>
        <label for="buyer-email" class="block font-mono text-xs text-[#8b94a5] uppercase mb-1">
          Adres e-mail * (dostęp i faktura)
        </label>
        <input 
          type="email" 
          id="buyer-email" 
          required 
          placeholder="jan@firma.pl"
          class="w-full bg-[#090a0c] border border-white/[0.12] px-3.5 py-2.5 text-xs sm:text-sm text-white placeholder-neutral-600 focus:outline-none focus:border-blue-500 transition-colors"
        />
      </div>

      <!-- Invoice Checkbox & Fields -->
      <div class="pt-2">
        <label class="flex items-center gap-2 cursor-pointer font-mono text-xs text-[#8b94a5] select-none">
          <input type="checkbox" id="need-invoice" class="rounded bg-[#090a0c] border-white/20 text-blue-500 focus:ring-0" />
          <span>Chcę otrzymać fakturę na firmę (B2B)</span>
        </label>
      </div>

      <div id="invoice-fields" class="hidden space-y-3 pt-2 border-t border-white/[0.04]">
        <div>
          <label for="company-nip" class="block font-mono text-xs text-[#8b94a5] uppercase mb-1">
            NIP firmy
          </label>
          <input 
            type="text" 
            id="company-nip" 
            placeholder="5252814890"
            class="w-full bg-[#090a0c] border border-white/[0.12] px-3.5 py-2.5 text-xs text-white placeholder-neutral-600 focus:outline-none focus:border-blue-500 transition-colors"
          />
        </div>
        <div>
          <label for="company-name" class="block font-mono text-xs text-[#8b94a5] uppercase mb-1">
            Nazwa firmy i adres
          </label>
          <input 
            type="text" 
            id="company-name" 
            placeholder="Firma Sp. z o.o., ul. Prosta 1, Warszawa"
            class="w-full bg-[#090a0c] border border-white/[0.12] px-3.5 py-2.5 text-xs text-white placeholder-neutral-600 focus:outline-none focus:border-blue-500 transition-colors"
          />
        </div>
      </div>

      <!-- Payment Method Selection -->
      <div id="payment-methods" class="space-y-2 pt-2">
        <div class="font-mono text-xs text-[#8b94a5] uppercase">
          Metoda płatności (mBank PayNow)
        </div>
        <div class="grid grid-cols-3 gap-2">
          <label class="flex flex-col items-center justify-center p-3 border border-white/[0.15] bg-[#090a0c] cursor-pointer hover:border-blue-500 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-500/10 transition-colors text-center">
            <input type="radio" name="payment-method" value="blik" checked class="sr-only" />
            <span class="font-mono text-xs font-bold text-white">BLIK</span>
            <span class="text-[10px] text-[#8b94a5]">Natychmiast</span>
          </label>
          <label class="flex flex-col items-center justify-center p-3 border border-white/[0.15] bg-[#090a0c] cursor-pointer hover:border-blue-500 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-500/10 transition-colors text-center">
            <input type="radio" name="payment-method" value="pbl" class="sr-only" />
            <span class="font-mono text-xs font-bold text-white">Przelew</span>
            <span class="text-[10px] text-[#8b94a5]">Pay-By-Link</span>
          </label>
          <label class="flex flex-col items-center justify-center p-3 border border-white/[0.15] bg-[#090a0c] cursor-pointer hover:border-blue-500 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-500/10 transition-colors text-center">
            <input type="radio" name="payment-method" value="card" class="sr-only" />
            <span class="font-mono text-xs font-bold text-white">Karta</span>
            <span class="text-[10px] text-[#8b94a5]">Visa / MC</span>
          </label>
        </div>
      </div>

      <!-- Free Registration Callout (if price = 0) -->
      <div id="free-registration-notice" class="hidden p-3 bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-300">
        ✓ Zniżka partnerska 100%: brak konieczności podawania płatności.
      </div>

      <!-- Submit Button -->
      <button 
        type="submit" 
        id="submit-order-btn"
        class="w-full py-4 px-6 bg-white hover:bg-neutral-200 text-[#090a0c] font-display font-bold text-sm tracking-wide uppercase transition-colors text-center flex items-center justify-center gap-2 mt-4"
      >
        <span id="submit-btn-text">Przejdź do płatności PayNow</span>
        <span class="font-mono text-xs">→</span>
      </button>

      <p class="font-mono text-[10px] text-neutral-500 text-center">
        Płatność szyfrowana 256-bit SSL. Przesyłając formularz, akceptujesz regulamin i politykę prywatności.
      </p>
    </form>

    <!-- Success View -->
    <div id="order-success" class="hidden py-8 text-center space-y-4">
      <div class="w-12 h-12 rounded-full bg-emerald-500/20 border border-emerald-500 text-emerald-400 mx-auto flex items-center justify-center text-xl font-bold font-mono">
        ✓
      </div>
      <h4 class="font-display text-xl font-bold text-white">
        Zgłoszenie zostało zarejestrowane!
      </h4>
      <p class="text-xs sm:text-sm text-[#8b94a5] font-body max-w-sm mx-auto leading-relaxed">
        Na Twój adres e-mail wysłaliśmy potwierdzenie z kalendarzem spotkań oraz danymi organizacyjnymi. Do zobaczenia na zjeździe!
      </p>
      <button 
        type="button" 
        id="success-close-btn"
        class="mt-4 px-6 py-2.5 bg-white text-[#090a0c] font-mono text-xs uppercase font-bold hover:bg-neutral-200 transition-colors"
      >
        Zamknij okno
      </button>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('checkout-modal');
  const closeBtn = document.getElementById('close-modal-btn');
  const successCloseBtn = document.getElementById('success-close-btn');
  const orderForm = document.getElementById('order-form') as HTMLFormElement | null;
  const orderSuccess = document.getElementById('order-success');
  const productNameEl = document.getElementById('modal-product-name');
  const productPriceEl = document.getElementById('modal-product-price');
  const submitBtnText = document.getElementById('submit-btn-text');
  const paymentMethods = document.getElementById('payment-methods');
  const freeNotice = document.getElementById('free-registration-notice');
  const needInvoiceCheckbox = document.getElementById('need-invoice') as HTMLInputElement | null;
  const invoiceFields = document.getElementById('invoice-fields');

  needInvoiceCheckbox?.addEventListener('change', () => {
    if (invoiceFields) {
      invoiceFields.classList.toggle('hidden', !needInvoiceCheckbox.checked);
    }
  });

  window.addEventListener('open-checkout-modal', (e: any) => {
    const detail = e.detail || {};
    if (productNameEl) productNameEl.textContent = detail.product || 'Usługa';
    if (productPriceEl) productPriceEl.textContent = `${detail.price} zł`;

    if (detail.price === 0) {
      paymentMethods?.classList.add('hidden');
      freeNotice?.classList.remove('hidden');
      if (submitBtnText) submitBtnText.textContent = 'Zarejestruj bezpłatny udział';
    } else {
      paymentMethods?.classList.remove('hidden');
      freeNotice?.classList.add('hidden');
      if (submitBtnText) submitBtnText.textContent = `Zapłać ${detail.price} zł przez PayNow`;
    }

    orderForm?.classList.remove('hidden');
    orderSuccess?.classList.add('hidden');
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  });

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeModal);
  successCloseBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeModal();
    }
  });

  orderForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    // Simulate submission / webhook trigger
    orderForm.classList.add('hidden');
    orderSuccess?.classList.remove('hidden');
  });
</script>

