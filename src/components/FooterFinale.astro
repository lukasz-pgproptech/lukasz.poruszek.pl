---
import { site } from '../data/site';
---

<footer class="pt-20 pb-12 border-t border-white/10 bg-[#050608]/80 backdrop-blur-sm relative overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 space-y-16">
    <!-- Top Row: Contact & Links -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      <div class="md:col-span-6 space-y-4">
        <div class="font-mono text-xs uppercase tracking-widest text-[#7e8594]">
          BEZPOŚREDNI KONTAKT
        </div>
        <div>
          <a 
            href={`mailto:${site.email}`} 
            class="font-display text-2xl sm:text-3xl font-bold text-white hover:text-blue-400 transition-colors inline-block min-h-[44px]"
            data-cursor="Email"
          >
            {site.email}
          </a>
        </div>
        <p class="text-sm text-[#7e8594] font-body max-w-sm">
          Praktyczny transfer wiedzy inżynierskiej i biznesowej. Czysta ekonomia czasu.
        </p>
      </div>

      <div class="md:col-span-3 space-y-3 font-mono text-xs text-[#7e8594]">
        <div class="text-white font-bold uppercase tracking-wider mb-2">
          DANE SPÓŁKI
        </div>
        <div>{site.company}</div>
        <div>NIP: <span class="text-white">{site.nip}</span></div>
        <div>REGON: <span class="text-white">{site.regon}</span></div>
        <div>KRS: <span class="text-white">{site.krs}</span></div>
        <div class="pt-1 text-neutral-400">Sąd Rejonowy dla m.st. Warszawy</div>
      </div>

      <div class="md:col-span-3 space-y-3 font-mono text-xs">
        <div class="text-white font-bold uppercase tracking-wider mb-2">
          SIEĆ & PROJEKTY
        </div>
        <div class="flex flex-col gap-2 text-[#7e8594]">
          {site.socials.map((s) => (
            <a 
              href={s.href} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="link-editorial hover:text-white transition-colors py-1 inline-flex items-center gap-1.5 min-h-[44px]"
            >
              <span>↗</span>
              <span>{s.label}</span>
            </a>
          ))}
          <a href="#hero" class="link-editorial hover:text-white transition-colors py-1 inline-flex items-center gap-1.5 min-h-[44px]">
            <span>↑</span>
            <span>Powrót na górę</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Monumental Name Finale (Byholm style) -->
    <div class="pt-4 select-none pointer-events-none" aria-hidden="true" role="presentation">
      <div class="font-display font-extrabold text-[clamp(2.5rem,10vw,8.5rem)] text-white/45 tracking-[-0.05em] leading-[0.85] uppercase text-center sm:text-left" aria-hidden="true" role="presentation">
        {site.name}
      </div>
    </div>

    <!-- Colophon Bottom Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-[#7e8594] pt-4 border-t border-white/5">
      <div>
        Architektura: Astro 5 • Tailwind v4 • Lenis • GSAP • Zero AI Slop.
      </div>
      <div>
        © {new Date().getFullYear()} {site.company}. Wszystkie prawa zastrzeżone.
      </div>
    </div>
  </div>
</footer>

