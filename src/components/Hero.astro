---
import { site } from '../data/site';
---

<section id="hero" class="relative pt-32 pb-20 md:pt-44 md:pb-28 border-b border-white/10 overflow-hidden min-h-[94vh] flex flex-col justify-between">
  <!-- Subtle architectural coordinate grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px),linear-gradient(to_bottom,#ffffff03_1px,transparent_1px)] bg-[size:5rem_5rem] [mask-image:radial-gradient(ellipse_75%_65%_at_50%_0%,#000_80%,transparent_100%)] pointer-events-none"></div>

  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 w-full relative z-10 flex-1 flex flex-col justify-between">
    <!-- Top Ledger Row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-white/10 pb-6 mb-12 sm:mb-16" data-intro data-reveal="fade">
      <div class="font-mono text-xs uppercase tracking-widest text-[#7e8594] flex items-center gap-3">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </span>
        <span>ARCHITEKTURA SYSTEMÓW AGENTOWYCH & B2B</span>
      </div>
      <div class="font-mono text-xs text-[#7e8594] flex items-center gap-4">
        <span>POLSKA GRUPA PROPTECH • WARSZAWA</span>
      </div>
    </div>

    <!-- Main Hero Stage: Monumental Typography + Tactile WebGL Image Plate -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center my-auto py-4">
      <!-- Left Column: Typographic Statement -->
      <div class="lg:col-span-7 space-y-6">
        <span class="font-serif italic text-2xl sm:text-3xl lg:text-4xl text-neutral-400 font-normal tracking-normal block" data-intro data-reveal="fade">
          Praktyka inżynierska i ekonomia czasu.
        </span>

        <h1 
          class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-[4.85rem] font-bold text-white tracking-[-0.04em] leading-[0.96] text-balance"
          data-intro
          data-split="lines"
        >
          Większość ludzi traci rok na błędy, które ktoś inny rozwiązał w 6 tygodni.
        </h1>

        <p 
          class="text-lg sm:text-xl text-[#8e95a5] font-body max-w-2xl leading-relaxed text-pretty"
          data-intro
          data-reveal="up"
          data-delay="0.1"
        >
          Przejmij sprawdzony system inżynierski, zredukuj miesiące błądzenia i buduj deterministyczne systemy multiagentowe na kodzie produkcyjnym.
        </p>

        <!-- Direct Action CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-4" data-intro data-reveal="up" data-delay="0.15">
          <a
            href="/#warsztaty"
            class="inline-flex items-center gap-3 px-7 py-3.5 bg-white text-[#090a0c] font-mono text-xs font-bold uppercase tracking-wider hover:bg-neutral-200 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 min-h-[48px]"
            data-cursor="Program"
          >
            <span>Sprawdź program warsztatów</span>
            <span>↓</span>
          </a>

          <a
            href="/#mentoring"
            class="inline-flex items-center gap-3 px-7 py-3.5 border border-white/20 hover:border-white text-white font-mono text-xs font-bold uppercase tracking-wider transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 min-h-[48px]"
            data-cursor="Termin"
          >
            <span>Umów mentoring 1:1</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Tactile WebGL Image Plate (Holm / Noomo aesthetic) -->
      <div class="lg:col-span-5 relative" data-intro data-reveal="fade" data-delay="0.2">
        <figure 
          data-gl 
          data-gl-instant
          class="relative w-full aspect-[4/5] sm:aspect-[3/4] lg:aspect-[4/5] rounded-xl overflow-hidden border border-white/10 shadow-2xl group" 
          data-cursor="Łukasz"
        >
          <img 
            src="/images/hero.webp" 
            alt="Łukasz Poruszek - Architekt Systemów AI i B2B" 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
            width="1080" 
            height="1350" 
            fetchpriority="high"
          />
          <div class="absolute bottom-0 inset-x-0 p-6 bg-gradient-to-t from-[#090a0c]/90 via-[#090a0c]/40 to-transparent flex items-end justify-between font-mono text-xs text-neutral-300 pointer-events-none">
            <div>
              <div class="font-bold text-white text-sm">ŁUKASZ PORUSZEK</div>
              <div class="text-[#7e8594] text-[11px] pt-0.5">Partner Technologiczny • Polska Grupa Proptech</div>
            </div>
            <div class="text-[11px] text-blue-400">WARSZAWA</div>
          </div>
        </figure>
      </div>
    </div>

    <!-- Bottom Architectural Telemetry Bar (Unique parameters, no repetitive pricing cards) -->
    <div 
      class="mt-14 pt-8 border-t border-white/10 grid grid-cols-2 md:grid-cols-4 gap-6"
      data-intro
      data-reveal="up"
      data-delay="0.25"
    >
      <div class="space-y-1">
        <span class="font-mono text-[11px] text-[#7e8594] uppercase tracking-wider block">Najbliższa kohorta</span>
        <span class="font-display text-lg font-bold text-white block">16 marca 2026</span>
        <span class="font-mono text-xs text-blue-400">6 tygodni zjazdów</span>
      </div>

      <div class="space-y-1">
        <span class="font-mono text-[11px] text-[#7e8594] uppercase tracking-wider block">Format pracy</span>
        <span class="font-display text-lg font-bold text-white block">Live Coding & Peer Rooms</span>
        <span class="font-mono text-xs text-[#7e8594]">Czwartki 18:30-20:30</span>
      </div>

      <div class="space-y-1">
        <span class="font-mono text-[11px] text-[#7e8594] uppercase tracking-wider block">Standard techniczny</span>
        <span class="font-display text-lg font-bold text-white block">Model Context Protocol</span>
        <span class="font-mono text-xs text-[#7e8594]">Gemini Pro / Ultra</span>
      </div>

      <div class="space-y-1">
        <span class="font-mono text-[11px] text-[#7e8594] uppercase tracking-wider block">Doraźny mentoring 1:1</span>
        <span class="font-display text-lg font-bold text-white block">90 min diagnozy</span>
        <span class="font-mono text-xs text-emerald-400">Biznes & Kariera</span>
      </div>
    </div>
  </div>
</section>
