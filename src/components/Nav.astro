---
import { site } from '../data/site';
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-[#0a0b0d]/85 backdrop-blur-md">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10 h-20 flex items-center justify-between">
    <!-- Brand Name (Top Left Corner) -->
    <a href="#hero" class="group flex items-baseline gap-2 py-2" data-cursor="Góra">
      <span class="font-display font-bold text-base tracking-tight text-white group-hover:text-neutral-300 transition-colors">
        ŁUKASZ PORUSZEK
      </span>
      <span class="font-mono text-[10px] text-[#7e8594] uppercase tracking-wider hidden sm:inline">
        ARCHITEKT AI
      </span>
    </a>

    <!-- Center Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-xs font-mono tracking-wider uppercase text-[#7e8594]" aria-label="Główna nawigacja">
      <a href="#warsztaty" class="link-editorial hover:text-white transition-colors py-2 min-h-[44px] flex items-center">
        01 Warsztaty
      </a>
      <a href="#mentoring" class="link-editorial hover:text-white transition-colors py-2 min-h-[44px] flex items-center">
        02 Mentoring
      </a>
      <a href="#manifest" class="link-editorial hover:text-white transition-colors py-2 min-h-[44px] flex items-center">
        03 Manifest
      </a>
      <a href="#doswiadczenie" class="link-editorial hover:text-white transition-colors py-2 min-h-[44px] flex items-center">
        04 Doświadczenie
      </a>
    </nav>

    <!-- Top Right Corner Action & Audio Controller -->
    <div class="flex items-center gap-4 sm:gap-6">
      <!-- Tactile Sound Toggle -->
      <button
        type="button"
        id="audio-toggle-btn"
        class="flex items-center gap-2 px-3 py-1.5 border border-white/10 hover:border-white/30 font-mono text-[11px] text-[#7e8594] hover:text-white transition-colors min-h-[36px]"
        aria-label="Przełącz dźwięk haptyczny"
        data-cursor="Audio"
      >
        <span id="sound-waves-icon" class="flex items-end gap-[2px] h-3 opacity-40">
          <span class="w-[2px] h-1.5 bg-current"></span>
          <span class="w-[2px] h-3 bg-current"></span>
          <span class="w-[2px] h-2 bg-current"></span>
        </span>
        <span class="tracking-wider">AUDIO: <span id="sound-status-label" class="font-bold">OFF</span></span>
      </button>

      <div class="hidden xl:flex items-center font-mono text-xs text-[#7e8594]">
        <span>Kohorta #01: 16 marca</span>
      </div>

      <a
        href="#warsztaty"
        class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 bg-white text-[#0a0b0d] font-mono text-xs font-bold uppercase tracking-wider hover:bg-neutral-200 transition-colors duration-200 min-h-[44px]"
        data-cursor="Zapisz"
      >
        <span>Sprawdź program</span>
      </a>
    </div>
  </div>
</header>

<script>
  import { initAudio, toggleAudio } from '../engine/audio';
  
  function bindAudio() {
    initAudio();
    const btn = document.getElementById('audio-toggle-btn');
    btn?.addEventListener('click', () => {
      toggleAudio();
    });
  }

  // Run on initial load and Astro page transitions
  bindAudio();
  document.addEventListener('astro:page-load', bindAudio);
</script>
