---
import { site } from '../data/site';
const { workshop, mentoring } = site;
const [biznes, kariera] = mentoring;
---

<section id="warsztaty" class="py-24 sm:py-36 border-b border-white/10 bg-[#0a0b0d]">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-10">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-8 border-b border-white/10 mb-12">
      <div>
        <div class="font-mono text-xs uppercase tracking-widest text-[#7e8594] mb-2">
          01 & 02 / REJESTR USŁUG
        </div>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight">
          Trzy sprawdzone ścieżki transferu wiedzy.
        </h2>
      </div>
      <div class="font-mono text-xs text-[#7e8594]">
        Czysta ekonomia czasu • Bezpośrednia realizacja
      </div>
    </div>

    <!-- Index List Container -->
    <div class="divide-y divide-white/10 border-b border-white/10">
      <!-- ROW 01: WARSZTATY ORKIESTRACJI AI -->
      <div class="py-10 sm:py-14 transition-colors group">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-baseline">
          <div class="lg:col-span-1 font-mono text-sm text-[#7e8594]">
            01
          </div>
          <div class="lg:col-span-5 space-y-2">
            <h3 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-white group-hover:text-blue-400 transition-colors">
              Warsztaty Orkiestracji AI
            </h3>
            <p class="text-sm sm:text-base text-[#7e8594] font-body leading-relaxed max-w-xl">
              6-tygodniowy zjazd kohortowy. Zamiast roku eksperymentów: inżynierskie wzorce projektowe, standard MCP, sandboxy i produkcyjne systemy multiagentowe.
            </p>
          </div>
          <div class="lg:col-span-3 font-mono text-xs text-[#7e8594] space-y-1">
            <div>FORMAT: 6x 120 min • Online na żywo</div>
            <div>START: {workshop.startDate}</div>
            <div class="text-white">WYMÓG: {workshop.prerequisite}</div>
          </div>
          <div class="lg:col-span-3 flex flex-col sm:items-end justify-between gap-4">
            <div class="font-display text-3xl font-bold text-white">
              1 200 PLN
            </div>
            <button 
              type="button"
              id="toggle-syllabus-btn"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-[#0a0b0d] hover:bg-neutral-200 font-mono text-xs font-bold uppercase tracking-wider transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 min-h-[44px]"
            >
              <span id="syllabus-toggle-text">Rozwiń program & Zapisz się</span>
              <span class="font-mono transition-transform" id="syllabus-toggle-icon">↓</span>
            </button>
          </div>
        </div>

        <!-- Expandable Architectural Syllabus Blueprint -->
        <div id="syllabus-drawer" class="hidden mt-12 pt-10 border-t border-white/10 space-y-12">
          <!-- 6-Week Modules Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {workshop.modules.map((m) => (
              <div class="p-6 border border-white/10 bg-[#111317] space-y-3">
                <div class="flex justify-between items-baseline font-mono text-xs text-blue-400">
                  <span class="font-bold">MODUŁ {m.number}</span>
                  <span class="text-[#7e8594]">TYDZIEŃ {m.number}</span>
                </div>
                <h4 class="font-display font-bold text-lg text-white">
                  {m.title}
                </h4>
                <div class="font-mono text-xs text-[#7e8594]">
                  {m.subtitle}
                </div>
                <ul class="pt-3 border-t border-white/10 space-y-2 text-xs text-[#7e8594]">
                  {m.points.map((p) => (
                    <li class="flex items-start gap-2">
                      <span class="text-blue-400">•</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>

          <!-- Checkout Box with Coupon Simulator inside the expanded row -->
          <div class="p-8 sm:p-10 border border-white/10 bg-[#111317] grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7 space-y-3">
              <div class="font-mono text-xs uppercase tracking-widest text-blue-400">
                GWARANCJA I PAKIET KOHORTY #01
              </div>
              <h4 class="font-display text-2xl font-bold text-white">
                Co dokładnie zawiera uczestnictwo:
              </h4>
              <ul class="space-y-2 pt-2 text-sm text-[#7e8594]">
                {workshop.features.map((feat) => (
                  <li class="flex items-start gap-2">
                    <span class="text-white">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="lg:col-span-5 p-6 border border-white/10 bg-[#0a0b0d] space-y-4">
              <div class="flex justify-between items-baseline">
                <span class="font-mono text-xs text-[#7e8594]">CENA KOŃCOWA:</span>
                <span id="drawer-price" class="font-display text-3xl font-bold text-white">1 200 PLN</span>
              </div>

              <!-- Coupon Code -->
              <div class="space-y-1.5">
                <div class="flex gap-2">
                  <input 
                    type="text" 
                    id="drawer-coupon-input"
                    placeholder="KOD RABATOWY"
                    class="flex-1 bg-[#111317] border border-white/15 px-3 py-2 text-xs font-mono text-white placeholder-neutral-500 uppercase focus:outline-none focus:border-white min-h-[44px]"
                  />
                  <button 
                    type="button" 
                    id="drawer-apply-coupon"
                    class="px-4 py-2 bg-white/10 hover:bg-white text-white hover:text-black font-mono text-xs font-bold uppercase transition-colors min-h-[44px]"
                  >
                    OK
                  </button>
                </div>
                <p id="drawer-coupon-msg" class="text-xs font-mono text-emerald-400 hidden"></p>
              </div>

              <button 
                type="button" 
                id="drawer-checkout-btn"
                class="w-full py-4 bg-white hover:bg-neutral-200 text-[#0a0b0d] font-mono text-xs font-bold uppercase tracking-wider transition-colors min-h-[48px] flex items-center justify-center gap-2"
                data-cursor="Zapisz"
              >
                <span>Przejdź do formularza PayNow</span>
                <span>→</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ROW 02: DORAŹNY MENTORING BIZNESOWY -->
      <div id="mentoring" class="py-10 sm:py-14 transition-colors group">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-baseline">
          <div class="lg:col-span-1 font-mono text-sm text-[#7e8594]">
            02
          </div>
          <div class="lg:col-span-5 space-y-2">
            <h3 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-white group-hover:text-blue-400 transition-colors">
              {biznes.title}
            </h3>
            <p class="text-sm sm:text-base text-[#7e8594] font-body leading-relaxed max-w-xl">
              {biznes.summary}
            </p>
            <div class="pt-3 text-xs text-[#7e8594] space-y-1 font-mono">
              <div>• Diagnoza wąskich gardeł i dekonstrukcja fałszywych założeń</div>
              <div>• Analiza szans na granty B+R (ścieżki NCBR, PARP)</div>
              <div>• Notatka wykonawcza z krokami o najwyższym ROI po sesji</div>
            </div>
          </div>
          <div class="lg:col-span-3 font-mono text-xs text-[#7e8594] space-y-1">
            <div>FORMAT: Sesja 1:1 online</div>
            <div>CZAS: 90 minut</div>
            <div class="text-white">ROZLICZENIE: Faktura VAT (Polska Grupa Proptech)</div>
          </div>
          <div class="lg:col-span-3 flex flex-col sm:items-end justify-between gap-4">
            <div class="font-display text-3xl font-bold text-white">
              {biznes.pricePln} PLN
            </div>
            <button 
              type="button"
              class="booking-trigger-btn inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 hover:bg-white text-white hover:text-black font-mono text-xs font-bold uppercase tracking-wider transition-colors min-h-[44px]"
              data-title={biznes.title}
              data-price={biznes.pricePln}
              data-cursor="Rezerwuj"
            >
              <span>Zarezerwuj termin (400 PLN)</span>
              <span>→</span>
            </button>
          </div>
        </div>
      </div>

      <!-- ROW 03: DORAŹNY MENTORING KARIERY -->
      <div class="py-10 sm:py-14 transition-colors group">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-baseline">
          <div class="lg:col-span-1 font-mono text-sm text-[#7e8594]">
            03
          </div>
          <div class="lg:col-span-5 space-y-2">
            <h3 class="font-display text-2xl sm:text-3xl md:text-4xl font-bold text-white group-hover:text-blue-400 transition-colors">
              {kariera.title}
            </h3>
            <p class="text-sm sm:text-base text-[#7e8594] font-body leading-relaxed max-w-xl">
              {kariera.summary}
            </p>
            <div class="pt-3 text-xs text-[#7e8594] space-y-1 font-mono">
              <div>• Bezwzględny audyt CV i profilu LinkedIn z perspektywy hiring managera</div>
              <div>• Niepisane reguły selekcji: korporacje vs dynamiczne MŚP</div>
              <div>• Prowadzenie wywiadu rekrutacyjnego i precyzyjne wycenienie stawek</div>
            </div>
          </div>
          <div class="lg:col-span-3 font-mono text-xs text-[#7e8594] space-y-1">
            <div>FORMAT: Sesja 1:1 online</div>
            <div>CZAS: 90 minut</div>
            <div class="text-white">ZASADA: Zero symulacji ról, czysta prawda rynkowa</div>
          </div>
          <div class="lg:col-span-3 flex flex-col sm:items-end justify-between gap-4">
            <div class="font-display text-3xl font-bold text-white">
              {kariera.pricePln} PLN
            </div>
            <button 
              type="button"
              class="booking-trigger-btn inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 hover:bg-white text-white hover:text-black font-mono text-xs font-bold uppercase tracking-wider transition-colors min-h-[44px]"
              data-title={kariera.title}
              data-price={kariera.pricePln}
              data-cursor="Rezerwuj"
            >
              <span>Zarezerwuj termin (300 PLN)</span>
              <span>→</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Drawer Toggle Logic
  const toggleBtn = document.getElementById('toggle-syllabus-btn');
  const drawer = document.getElementById('syllabus-drawer');
  const toggleText = document.getElementById('syllabus-toggle-text');
  const toggleIcon = document.getElementById('syllabus-toggle-icon');

  toggleBtn?.addEventListener('click', () => {
    if (!drawer) return;
    const isHidden = drawer.classList.contains('hidden');
    drawer.classList.toggle('hidden', !isHidden);
    if (toggleText) toggleText.textContent = isHidden ? 'Zwiń program' : 'Rozwiń program & Zapisz się';
    if (toggleIcon) toggleIcon.textContent = isHidden ? '↑' : '↓';
  });

  // Drawer Coupon Logic
  const couponInput = document.getElementById('drawer-coupon-input') as HTMLInputElement | null;
  const applyBtn = document.getElementById('drawer-apply-coupon');
  const priceDisplay = document.getElementById('drawer-price');
  const couponMsg = document.getElementById('drawer-coupon-msg');
  const checkoutBtn = document.getElementById('drawer-checkout-btn');

  let activePrice = 1200;
  let activeDiscount = 0;

  applyBtn?.addEventListener('click', () => {
    if (!couponInput || !priceDisplay || !couponMsg) return;
    const code = couponInput.value.trim().toUpperCase();

    if (code === 'PARTNER100' || code === 'KOD0' || code === 'ANTIGRAVITY' || code === 'FREE') {
      activePrice = 0;
      activeDiscount = 1200;
      priceDisplay.textContent = '0 PLN';
      couponMsg.textContent = 'Kod aktywny: Zniżka partnerska 100% (-1200 PLN).';
      couponMsg.classList.remove('hidden', 'text-red-400');
      couponMsg.classList.add('text-emerald-400');
    } else if (code === 'START20' || code === 'EARLYBIRD') {
      activePrice = 960;
      activeDiscount = 240;
      priceDisplay.textContent = '960 PLN';
      couponMsg.textContent = 'Kod aktywny: Zniżka 20% (-240 PLN).';
      couponMsg.classList.remove('hidden', 'text-red-400');
      couponMsg.classList.add('text-emerald-400');
    } else {
      couponMsg.textContent = 'Nieprawidłowy kod zniżkowy.';
      couponMsg.classList.remove('hidden', 'text-emerald-400');
      couponMsg.classList.add('text-red-400');
    }
  });

  checkoutBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-checkout-modal', {
      detail: {
        product: 'Warsztaty Orkiestracji AI (Kohorta #01)',
        price: activePrice,
        discount: activeDiscount
      }
    }));
  });

  // Mentoring Booking Buttons
  document.querySelectorAll('.booking-trigger-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      window.dispatchEvent(new CustomEvent('open-checkout-modal', {
        detail: {
          product: target.dataset.title || 'Mentoring 1:1',
          price: parseInt(target.dataset.price || '400', 10),
          discount: 0
        }
      }));
    });
  });
</script>

